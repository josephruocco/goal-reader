{
  "manifest_version": 3,
  "name": "Goal Reader (PDF)",
  "version": "0.1.0",
  "description": "Open PDFs in a goal-based reader with page progress + timer.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "sw.js" },
  "action": { "default_title": "Goal Reader" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}